algoritmo "semnome"
//  Ler dois valores (considere que não serão lidos valores iguais) e escrever o maior deles.
var
 v1, v2 : real
inicio
escreval("Informe o valor 1: ")
leia(v1)

escreval("Informe o valor 2: ")
leia(v2)

se v1 > v2 entao
escreval(v1, " é maior.")
senao
escreval(v2, " é maior.")

fimse
fimalgoritmo
